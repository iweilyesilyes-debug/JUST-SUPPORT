# ═══════════════════════════════════════════════════════════════════
#  L'Big Time Community — Discord keys
#  انسخ هذا الملف إلى .env.local وعمّر القيم. ما تعملش commit لـ .env.local
# ═══════════════════════════════════════════════════════════════════

# 1) Discord Application → OAuth2
#    https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Redirect URI (حطه كيف ما هو في Discord Developer Portal → OAuth2 → Redirects)
# في localhost: http://localhost:3000/api/auth/callback
# في production: https://your-domain.com/api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 2) Bot — لقراءة اللوغات والأعضاء والأدوار (Bot → Token)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# 3) Owner roles — آي دي رولات عندها كل الصلاحيات تلقائياً
#    فصل بيناتهم بفاصلة: 123456789012345678,987654321098765432
DISCORD_OWNER_ROLE_IDS=

# 4) مفتاح تشفير الـ session cookie — long random string
#    PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
SESSION_SECRET=

# 5) Site URL — للـ metadata و redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 6) (اختياري) مسار تخزين data/permissions.json
#    مفيد في production إذا العملية الحالية read-only.
# DATA_DIR=C:\data\lbig-time
